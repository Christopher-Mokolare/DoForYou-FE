# Frontend Environment Variables
# Copy this file to .env.development, .env.qa, or .env.production
# and update with your environment-specific values

# API Configuration
API_URL=your-api-url-here
API_KEY=your-api-key-here

# External Services
WHATSAPP_NUMBER=27795258611
CONTACT_EMAIL=your-contact-email
SUPPORT_PHONE=0795258611
